{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "magpie-bot",
  "version": "0.1.0",
  "identifier": "com.magpie.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "hud",
        "title": "喜鹊助手",
        "url": "index.html",
        "width": 640,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      },
      {
        "label": "panel",
        "title": "喜鹊助手 · 会话面板",
        "url": "panel.html",
        "width": 480,
        "height": 640,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
